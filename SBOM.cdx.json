  "components": [
    {
      "type": "application",
      "bom-ref": "bridge",
      "name": "Standalone EWS bridge",
      "description": "Repository implementation of the standalone EWS bridge.",
      "scope": "required"
    },
    {
      "type": "application",
      "bom-ref": "backend",
      "name": "Z-Push JMAP backend",
      "description": "Repository backend for use with an external Z-Push installation.",
      "scope": "optional"
    },
    {
      "type": "application",
      "bom-ref": "tests",
      "name": "Repository tests",
      "description": "Optional repository tests, including live integration checks.",
      "scope": "optional"
    },
    {
