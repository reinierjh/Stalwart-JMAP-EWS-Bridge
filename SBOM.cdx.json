      "description": "Repository SBOM generation tool.",
      "scope": "optional"
    },
    {
      "type": "framework",
      "bom-ref": "php",
      "name": "PHP",
      "description": "PHP runtime; installed version is not established by this source inventory.",
      "scope": "required"
    },
    {
      "type": "library",
      "bom-ref": "php-curl",
      "name": "PHP cURL extension",
      "description": "HTTP transport used by the JMAP client.",
      "scope": "required"
    },
    {
      "type": "library",
      "bom-ref": "php-dom-libxml",
      "name": "PHP DOM and libxml",
      "description": "XML parsing and generation used by the EWS bridge.",
      "scope": "required"
    },
    {
      "type": "library",
      "bom-ref": "pdo-sqlite",
