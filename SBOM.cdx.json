    },
    {
      "type": "library",
      "bom-ref": "php-posix",
      "name": "PHP POSIX extension",
      "description": "POSIX functions used by the sync store.",
      "scope": "required"
    },
    {
      "type": "platform",
      "bom-ref": "php-fsync",
      "name": "PHP fsync support",
      "description": "PHP fsync function and a filesystem supporting durable fsync and SQLite WAL locking.",
      "scope": "required"
    },
    {
      "type": "framework",
      "bom-ref": "z-push",
      "name": "Z-Push",
      "description": "External framework required only when running the Z-Push JMAP backend; not bundled.",
